# Linux deployment and public regression checks. The Windows private suite is separate.
add_executable(rutool_runtime_check packaging/linux/RuntimeCheck.c)
set_target_properties(rutool_runtime_check PROPERTIES OUTPUT_NAME runtime-check C_STANDARD 11 C_STANDARD_REQUIRED ON)
target_link_libraries(rutool_runtime_check PRIVATE ${CMAKE_DL_LIBS})
rutool_quality(rutool_runtime_check)
install(TARGETS rutool_runtime_check RUNTIME DESTINATION libexec/rutool)
foreach(config_file update-public.der installer-keys.json)
    configure_file(config/${config_file} "${CMAKE_CURRENT_BINARY_DIR}/app/config/${config_file}" COPYONLY)
endforeach()
install(FILES config/update-public.der config/installer-keys.json DESTINATION bin/app/config)
install(FILES assets/License.txt LICENSE NOTICE DESTINATION share/licenses/rutool)
install(DIRECTORY licenses/ DESTINATION share/licenses/rutool/third-party)
install(FILES packaging/linux/rutool.desktop DESTINATION share/applications)
install(FILES packaging/linux/rutool.svg DESTINATION share/icons/hicolor/scalable/apps)
if(BUILD_TESTING)
    find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
    add_test(NAME linux_runtime_selection COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/linux-tests/RuntimeSelectionTests.py"
        "$<TARGET_FILE:rutool_runtime_check>" "${CMAKE_CURRENT_SOURCE_DIR}/packaging/linux/AppRun" "${CMAKE_C_COMPILER}")
    set_tests_properties(linux_runtime_selection PROPERTIES TIMEOUT 20)
    qt_add_executable(rutool_linux_tests linux-tests/LinuxTests.cpp)
    qt_add_executable(rutool_core_tests linux-tests/CoreTests.cpp)
    qt_add_executable(rutool_linux_update_tests linux-tests/LinuxUpdateTests.cpp)
    target_compile_definitions(rutool_linux_update_tests PRIVATE RUTOOL_TEST_FIXTURES="${CMAKE_CURRENT_SOURCE_DIR}/linux-tests/fixtures")
    target_link_libraries(rutool_linux_update_tests PRIVATE Qt6::Test Qt6::Concurrent rutool_linux_updates rutool_portable_crypto)
    find_program(RUTOOL_TEST_OPENSSL openssl)
    if(RUTOOL_TEST_OPENSSL)
        target_compile_definitions(rutool_linux_update_tests PRIVATE RUTOOL_TEST_OPENSSL="${RUTOOL_TEST_OPENSSL}"
            RUTOOL_PYTHON="${Python3_EXECUTABLE}" RUTOOL_CHANNEL_SIGNER="${CMAKE_CURRENT_SOURCE_DIR}/scripts/sign-linux-channel.py")
    endif()
    rutool_quality(rutool_linux_update_tests)
    foreach(test_target rutool_linux_tests rutool_core_tests)
        target_link_libraries(${test_target} PRIVATE Qt6::Test rutool_core rutool_security)
        target_compile_definitions(${test_target} PRIVATE RUTOOL_TEST_FIXTURES="${CMAKE_CURRENT_SOURCE_DIR}/linux-tests/fixtures")
        rutool_quality(${test_target})
    endforeach()
    target_link_libraries(rutool_core_tests PRIVATE Qt6::Network rutool_network rutool_portable_crypto)
    target_link_libraries(rutool_linux_tests PRIVATE rutool_linux_updates)
    target_compile_definitions(rutool_core_tests PRIVATE RUTOOL_PYTHON="${Python3_EXECUTABLE}"
        RUTOOL_DELTA_GENERATOR="${CMAKE_CURRENT_SOURCE_DIR}/scripts/build-addon-delta.py")
    qt_add_executable(rutool_linux_ui_tests linux-tests/UiTests.cpp
        src/app/ClientController.cpp src/app/ClientOperations.cpp ${rutool_updates}
        src/app/ClientPremium.cpp src/app/ClientController.hpp)
    target_include_directories(rutool_linux_ui_tests PRIVATE src/app)
    target_link_libraries(rutool_linux_ui_tests PRIVATE Qt6::Test Qt6::Quick Qt6::QuickControls2
        Qt6::Concurrent rutool_network rutool_ui_support rutool_linux_updates)
    qt_add_qml_module(rutool_linux_ui_tests URI RuTool.App VERSION 1.0 NO_PLUGIN
        OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qml-targets/rutool_linux_ui_tests/RuTool/App"
        QML_FILES ${rutool_qml_files})
    qt_add_resources(rutool_linux_ui_tests ui_test_artwork PREFIX /assets BASE assets
        FILES assets/Background.png assets/BackgroundDark.jpg assets/Arona.gif assets/RuTool.ico assets/License.txt)
    rutool_quality(rutool_linux_ui_tests)
    add_test(NAME core_workflows COMMAND rutool_core_tests)
    add_test(NAME linux_updates COMMAND rutool_linux_update_tests)
    add_test(NAME linux_platform COMMAND rutool_linux_tests)
    set_tests_properties(core_workflows linux_platform linux_updates PROPERTIES TIMEOUT 60)
    add_test(NAME linux_qml_workflows COMMAND rutool_linux_ui_tests)
    set_tests_properties(linux_qml_workflows PROPERTIES
        ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software" TIMEOUT 45)
    add_test(NAME linux_production_qml COMMAND RuTool --smoke-test --smoke-screenshot "${CMAKE_CURRENT_BINARY_DIR}/linux-smoke.png")
    set_tests_properties(linux_production_qml PROPERTIES
        ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software" TIMEOUT 20)
endif()

set(RUTOOL_LINUX_UPDATE_REPOSITORY "" CACHE STRING "GitHub owner/repo for signed Linux updates; empty disables the channel")
set(RUTOOL_LINUX_UPDATE_CHANNEL_REF "linux-updates-v1" CACHE STRING "Permanent branch serving signed linux-channel-v1.json")
set(RUTOOL_LINUX_UPDATE_PUBLIC_KEY "" CACHE FILEPATH "Public ECDSA P-256 SPKI DER key; never a private key")
if(NOT RUTOOL_LINUX_UPDATE_CHANNEL_REF MATCHES "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$")
    message(FATAL_ERROR "Invalid Linux update channel ref")
endif()
if(NOT RUTOOL_LINUX_UPDATE_REPOSITORY STREQUAL "")
    if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
        message(FATAL_ERROR "The Linux update protocol currently supports x86_64 only")
    endif()
    if(NOT RUTOOL_LINUX_UPDATE_REPOSITORY MATCHES "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
       OR NOT EXISTS "${RUTOOL_LINUX_UPDATE_PUBLIC_KEY}" OR NOT RUTOOL_LINUX_UPDATE_PUBLIC_KEY MATCHES "[.]der$")
        message(FATAL_ERROR "Set a valid GitHub owner/repo and a public SPKI DER key for Linux updates")
    endif()
    file(SIZE "${RUTOOL_LINUX_UPDATE_PUBLIC_KEY}" linux_key_bytes)
    file(READ "${RUTOOL_LINUX_UPDATE_PUBLIC_KEY}" linux_key_header LIMIT 26 HEX)
    if(NOT linux_key_bytes EQUAL 91 OR NOT linux_key_header STREQUAL "3059301306072a8648ce3d020106082a8648ce3d030107034200")
        message(FATAL_ERROR "Expected an uncompressed P-256 public SPKI DER key; private keys must never be bundled")
    endif()
    set_source_files_properties("${RUTOOL_LINUX_UPDATE_PUBLIC_KEY}" PROPERTIES QT_RESOURCE_ALIAS public.der)
endif()
set(linux_update_targets ${rutool_app_targets})
if(BUILD_TESTING)
    list(APPEND linux_update_targets rutool_linux_ui_tests)
endif()
foreach(target IN LISTS linux_update_targets)
    target_compile_definitions(${target} PRIVATE
        RUTOOL_LINUX_UPDATE_REPOSITORY="${RUTOOL_LINUX_UPDATE_REPOSITORY}"
        RUTOOL_LINUX_UPDATE_CHANNEL_REF="${RUTOOL_LINUX_UPDATE_CHANNEL_REF}")
    if(NOT RUTOOL_LINUX_UPDATE_REPOSITORY STREQUAL "")
        qt_add_resources(${target} linux_update_key_${target} PREFIX /linux-updates FILES "${RUTOOL_LINUX_UPDATE_PUBLIC_KEY}")
    endif()
endforeach()
